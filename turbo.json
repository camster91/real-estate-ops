{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": ["PORT", "HOST"]
		}
	},
	"globalDependencies": ["tsconfig.base.json"],
	"globalEnv": ["NODE_ENV", "REO_TEST_BROWSER_EXECUTABLE"]
}
