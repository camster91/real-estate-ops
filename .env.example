NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Staff login (ADR 0012). Login is off unless a provider is fully configured.
# Real values belong in a secret manager, never in git. See docs/platform/IDP_SETUP.md.
REO_PUBLIC_URL=http://127.0.0.1:4000
# Required when login is on: a login role that is a member of reo_app.
REO_DATABASE_URL=
REO_LOGIN_COOKIE_SECRET=
REO_GOOGLE_CLIENT_ID=
REO_GOOGLE_CLIENT_SECRET=
# Optional, comma-separated Google Workspace domains.
REO_GOOGLE_HOSTED_DOMAINS=
REO_MICROSOFT_CLIENT_ID=
REO_MICROSOFT_CLIENT_SECRET=
# One Entra tenant ID (a UUID); never common, organizations or consumers.
REO_MICROSOFT_TENANT_ID=
